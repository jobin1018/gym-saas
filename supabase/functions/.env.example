# Copy to .env and fill in. `.env` is gitignored — never commit real values.
#   cp supabase/functions/.env.example supabase/functions/.env
#
# Loaded with:
#   supabase functions serve --env-file supabase/functions/.env
#
# For a deployed project these go in `supabase secrets set NAME=value` instead.
#
# NOT LISTED HERE: SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. The edge runtime injects those automatically, both
# locally and hosted. Do not set them by hand.

# --- Meta / WhatsApp Cloud API ---------------------------------------------
# Outbound sending is REAL (see _shared/whatsapp.ts): every send from
# whatsapp-webhook, send-renewal-reminder and daily-owner-brief calls Meta's
# Cloud API with these two. Without them, sends fail closed (logged as
# 'failed', nothing crashes) rather than silently doing nothing.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Business-initiated sends (renewal reminders, daily briefs) go out as
# free-form "type":"text" messages, NOT approved templates — no templates are
# submitted/approved in Meta Business Manager yet. This only works within
# Meta's 24h customer-service window; see the TODO(meta) in
# _shared/whatsapp.ts for the switch-over once a template is approved.

# Set to `mock` to skip the real Meta call and fall back to the old
# console.log + 'queued' row (no network call, no whatsapp_messages
# wa_message_id). LIVE is the default the moment this is unset — every
# test.sh in this directory checks this is `mock` before running, specifically
# so `bash run-all-tests.sh` can never send a real WhatsApp message.
WHATSAPP_SEND_MODE=mock

# Echoed back during Meta's GET webhook verification handshake. You choose this
# value; it must match what you type into the Meta dashboard.
META_VERIFY_TOKEN=

# HMAC key for X-Hub-Signature-256 on inbound POSTs. In production this is the
# App Secret from the Meta *app* dashboard (Settings -> Basic), NOT a WhatsApp
# product credential. Any value works locally as long as test.sh signs with the
# same one.
META_APP_SECRET=

# --- Razorpay (TEST MODE) ---------------------------------------------------
# Dashboard -> Settings -> API Keys (test mode). These are REAL and are really
# called: send-renewal-reminder creates live payment links with them.
# Both test suites that touch Razorpay refuse to run against an rzp_live_ key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> the secret YOU typed when creating the
# webhook. NOT the API key secret, and not shown anywhere afterwards.
# razorpay-webhook fails closed (500) without it.
RAZORPAY_WEBHOOK_SECRET=

# Set to `mock` for automated tests ONLY: send-renewal-reminder then never calls
# Razorpay. Link creation returns plink_mock_<amount in paise>_<ref> and
# https://rzp.mock/<id>. Default (unset) is the real Razorpay API. The suites for
# send-renewal-reminder, renewal-scan and whatsapp-webhook refuse to run unless
# this is `mock`; the by-hand real check is
# send-renewal-reminder/smoke-real-razorpay.sh.
# RAZORPAY_MODE=mock

# --- UPI QR payments ---------------------------------------------------------
# Base URL of the member-facing pay page (a frontend route that calls the
# get-pay-page / claim-paid functions). The reminder sends <base>/<token>.
# Without it, QR gyms are skipped with reason pay_page_url_not_configured.
PAY_PAGE_BASE_URL=http://localhost:3000/pay
# Public pay-page rate limit, per client per window (defaults 30 / 60s).
# PAY_PAGE_RATE_LIMIT=30
# PAY_PAGE_RATE_WINDOW_SECONDS=60

# --- Optional tuning (all have working defaults) ----------------------------

# Calendar day / billing date resolution. Everything date-shaped resolves in
# this zone, not UTC. Per-tenant zones come from locations.timezone where the
# function reads them; this is the fallback.
# BILLING_TIMEZONE=Asia/Kolkata

# Overrides BILLING_TIMEZONE for send-renewal-reminder's once-per-day guard only.
# REMINDER_TIMEZONE=Asia/Kolkata

# Which days before (positive) or after (negative) current_period_end
# renewal-scan sends on. Discrete offsets, not a range — a contiguous window
# would message a member every day as it counts down.
# Add negative values to enable dunning for past_due memberships.
# REMINDER_OFFSET_DAYS=7,3

# Pause between reminders in a renewal-scan batch, to stay under Razorpay's
# per-account rate limit. 0 disables.
# RENEWAL_SCAN_DELAY_MS=250

# daily-owner-brief's "failed to send" counter. status='failed' is already
# real (a Meta API error sets it directly). This only gates the ADDITIONAL
# stale-queued heuristic: Meta's delivery-status webhook (sent -> delivered ->
# read) is not consumed yet (see the TODO(meta) in whatsapp-webhook/index.ts),
# so nothing ever advances a 'sent' row further, and 'queued' only happens in
# WHATSAPP_SEND_MODE=mock. Set to `live` once that webhook is wired up.
# WHATSAPP_DELIVERY_TRACKING=simulated
# WHATSAPP_STALE_QUEUED_MINUTES=120

# Override the URL renewal-scan uses to reach send-renewal-reminder. Defaults to
# ${SUPABASE_URL}/functions/v1/send-renewal-reminder, which is correct locally
# (http://kong:8000) and when deployed.
# SEND_RENEWAL_REMINDER_URL=
