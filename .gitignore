# ---------------------------------------------------------------------------
# SECRETS — the two entries that actually matter
# ---------------------------------------------------------------------------
# supabase/functions/.env holds live Razorpay and Meta credentials.
# supabase/.temp/start-secrets/ holds a copy of those PLUS the service role key,
# written by `supabase start` when it hands secrets to the edge runtime.
#
# A leaked service role key bypasses RLS on every table for every tenant.
# If either is ever committed, rotating the keys is the fix — deleting the
# commit is not, because the value stays in the object database and in every
# clone and fork that already pulled it.
supabase/functions/.env
supabase/functions/.env.*
!supabase/functions/.env.example

.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Supabase CLI local state
# ---------------------------------------------------------------------------
# Generated by `supabase start` / `supabase link`. Machine-specific, and
# start-secrets/ inside it contains credentials (see above).
supabase/.temp/
supabase/.branches/

# Local Postgres dumps, if you ever take one. These contain real member phone
# numbers once the database is not just seed data.
*.dump
*.sql.gz
supabase/db_dumps/

# ---------------------------------------------------------------------------
# Node / tooling
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deno caches, if you ever run functions outside the Supabase runtime
.deno/
deno.lock

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
# .vscode/extensions.json and settings.json ARE tracked on purpose — they are
# shared project config. Only per-developer overrides are ignored.
.vscode/*.local.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# settings.json is shared project config; settings.local.json is per-developer
# permissions and should not be.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
*.log
tmp/
scratch/
